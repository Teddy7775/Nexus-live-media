{% extends "base.html.j2" %}
{% block main %}
<section class="block"><div class="narrow">
  <p class="kicker">{{ series_name }}</p><h1>{{ t.parents.title }}</h1><p class="lead">{{ t.parents.lead }}</p>
  <div class="card mt"><h2 style="font-size:1.3rem">{{ t.parents.privacy_title }}</h2><p>{{ t.parents.privacy }}</p></div>
  {% for b in blocks %}
  <div class="parents-book" data-book-block="{{ b.slug }}">
    <h2 class="mt">{{ b.title }}</h2>
    {% if b.note %}<div class="card mt"><h3 style="font-size:1.15rem;margin-top:0">{{ b.note.title }}</h3><p>{{ b.note.text }}</p></div>{% endif %}
    <h3 class="mt">{{ t.parents.from_guide }}</h3>
    <div class="guide-body" lang="{{ L }}">{{ b.html|safe }}</div>
    <p class="mt"><a class="btn btn-ghost" href="{{ b.guide_url }}">{{ t.book.read_guide }}</a></p>
  </div>
  {% endfor %}
</div></section>
{% endblock %}
